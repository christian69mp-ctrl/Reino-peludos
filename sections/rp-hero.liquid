<section
  class="rp-hero rp-hero--focal-{{ section.settings.focal_point }}{% if section.settings.mobile_image != blank %} rp-hero--has-mobile-image{% endif %}"
  id="{{ section.id }}"
>
  <div class="rp-hero__media rp-hero__media--desktop" data-rp-parallax>
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000'
      }}
    {%- else -%}
      <img
        src="{{ 'reino-banner.jpg' | asset_url }}"
        alt="{{ shop.name }}"
        width="1584"
        height="672"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  {%- if section.settings.mobile_image != blank -%}
    <div class="rp-hero__media rp-hero__media--mobile">
      {{
        section.settings.mobile_image
        | image_url: width: 1000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '500, 750, 1000'
      }}
    </div>
  {%- endif -%}

  <span class="rp-paw-float rp-paw-float--1">{% render 'rp-icon', icon: 'paw' %}</span>
  <span class="rp-paw-float rp-paw-float--2">{% render 'rp-icon', icon: 'paw' %}</span>
  <span class="rp-paw-float rp-paw-float--3">{% render 'rp-icon', icon: 'paw' %}</span>
  <span class="rp-paw-float rp-paw-float--4">{% render 'rp-icon', icon: 'paw' %}</span>

  <div class="rp-hero__inner">
    {%- if section.settings.show_overlay_text -%}
      {%- if section.settings.logo != blank -%}
        <img
          class="rp-hero__crest rp-reveal rp-reveal--scale"
          src="{{ section.settings.logo | image_url: width: 160 }}"
          alt="{{ shop.name }}"
          width="76"
          height="76"
          loading="eager"
        >
      {%- else -%}
        <img
          class="rp-hero__crest rp-reveal rp-reveal--scale"
          src="{{ 'reino-logo.jpg' | asset_url }}"
          alt="{{ shop.name }}"
          width="76"
          height="76"
          loading="eager"
          style="border-radius: 50%;"
        >
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="rp-hero__eyebrow rp-reveal" data-rp-group="hero">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="rp-hero__heading rp-reveal" data-rp-group="hero">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="rp-hero__subheading rp-reveal" data-rp-group="hero">{{ section.settings.subheading }}</div>
      {%- endif -%}
    {%- endif -%}

    <div class="rp-hero__actions rp-reveal" data-rp-group="hero">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 | default: '#' }}" class="rp-btn rp-btn--primary">
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="rp-btn rp-btn--ghost">
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RP · Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo (banner) — escritorio"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen de fondo — móvil (opcional)",
      "info": "Si tu banner es muy panorámico, sube aquí un recorte más vertical para que no se corte el contenido importante en el móvil."
    },
    {
      "type": "select",
      "id": "focal_point",
      "label": "Punto focal de la imagen de escritorio",
      "info": "Controla qué parte de la imagen se prioriza si hay que recortarla.",
      "default": "center",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_overlay_text",
      "label": "Mostrar logo, titular y texto sobre la imagen",
      "info": "Desactívalo si tu imagen de banner ya incluye texto o mensaje propio.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo / escudo (opcional, si no se usa el favicon del tema)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Reino Peludos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Accesorios con corazón para cada mascota de tu reino"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "<p>Perros, gatos, conejos, aves, peces y más: productos pensados para el bienestar y la felicidad de cada integrante de tu familia.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Botón principal — texto",
      "default": "Ver todos los productos"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Botón principal — enlace"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Botón secundario — texto",
      "default": "Descubre por mascota"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Botón secundario — enlace"
    }
  ],
  "presets": [
    {
      "name": "RP · Hero"
    }
  ]
}
{% endschema %}
