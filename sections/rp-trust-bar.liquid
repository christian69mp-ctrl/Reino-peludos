{%- liquid
  assign rp_trust_has_bg = false
  if section.settings.background_image != blank or section.settings.use_sample_image
    assign rp_trust_has_bg = true
  endif
-%}

<section class="rp-trust color-{{ section.settings.color_scheme }}{% if rp_trust_has_bg %} rp-trust--has-bg{% endif %}" id="{{ section.id }}">
  {%- if rp_trust_has_bg -%}
    <div class="rp-trust__media">
      {%- if section.settings.background_image != blank -%}
        {{ section.settings.background_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600, 900, 1200, 1600' }}
      {%- else -%}
        <img src="{{ 'rp-banner-envios.jpg' | asset_url }}" alt="" loading="lazy" width="1376" height="768">
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="rp-trust__grid">
    {%- for block in section.blocks -%}
      <div class="rp-trust__item rp-reveal rp-reveal--scale" data-rp-group="trust" {{ block.shopify_attributes }}>
        <span class="rp-trust__icon">{% render 'rp-icon', icon: block.settings.icon %}</span>
        <span class="rp-trust__text">{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RP · Barra de confianza",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-4"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagen de fondo (opcional)"
    },
    {
      "type": "checkbox",
      "id": "use_sample_image",
      "label": "Usar imagen de ejemplo si no subo una arriba",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Elemento",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Camión (envío)" },
            { "value": "shield", "label": "Escudo (seguridad)" },
            { "value": "return", "label": "Devolución" },
            { "value": "heart", "label": "Corazón" },
            { "value": "paw", "label": "Huella" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío rápido"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RP · Barra de confianza",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "text": "Envío gratis · 5-8 días" } },
        { "type": "item", "settings": { "icon": "shield", "text": "Pago 100% seguro" } },
        { "type": "item", "settings": { "icon": "return", "text": "Devolución gratis 30 días" } },
        { "type": "item", "settings": { "icon": "heart", "text": "+2.000 mascotas felices" } }
      ]
    }
  ]
}
{% endschema %}
