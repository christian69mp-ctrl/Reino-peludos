<section class="rp-categories color-{{ section.settings.color_scheme }}" id="{{ section.id }}">
  <div class="rp-categories__header rp-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rp-categories__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="rp-categories__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="rp-categories__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="rp-categories__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign rp_fallback_asset = ''
        case block.settings.icon
          when 'dog'
            assign rp_fallback_asset = 'rp-cat-dogs.jpg'
          when 'cat'
            assign rp_fallback_asset = 'rp-cat-cats.jpg'
          when 'rabbit'
            assign rp_fallback_asset = 'rp-cat-rabbits.jpg'
          when 'bird'
            assign rp_fallback_asset = 'rp-cat-birds.jpg'
          when 'fish'
            assign rp_fallback_asset = 'rp-cat-fish.jpg'
          when 'rodent'
            assign rp_fallback_asset = 'rp-cat-rodents.jpg'
          when 'leash'
            assign rp_fallback_asset = 'rp-cat-paseo.jpg'
          when 'moon'
            assign rp_fallback_asset = 'rp-cat-descanso.jpg'
          when 'toy'
            assign rp_fallback_asset = 'rp-cat-juguetes.jpg'
          when 'bowl'
            assign rp_fallback_asset = 'rp-cat-comederos.jpg'
          when 'other'
            assign rp_fallback_asset = 'rp-cat-other.jpg'
          when 'frog'
            assign rp_fallback_asset = 'rp-cat-amphibians.jpg'
          when 'aquarium'
            assign rp_fallback_asset = 'rp-cat-aquarios.jpg'
          when 'terrarium'
            assign rp_fallback_asset = 'rp-cat-terrarios.jpg'
          when 'pill'
            assign rp_fallback_asset = 'rp-cat-salud.jpg'
        endcase
        assign rp_has_photo = false
        if block.settings.image != blank or rp_fallback_asset != ''
          assign rp_has_photo = true
        endif
      -%}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="rp-category-card rp-reveal rp-reveal--scale{% if rp_has_photo %} rp-category-card--photo{% endif %}"
        data-rp-group="categories"
        {{ block.shopify_attributes }}
      >
        {%- if rp_has_photo -%}
          <span class="rp-category-card__photo">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 500
                | image_tag: loading: 'lazy', widths: '260, 380, 500', sizes: '(min-width: 750px) 280px, 45vw'
              }}
            {%- else -%}
              <img
                src="{{ rp_fallback_asset | asset_url }}"
                alt="{{ block.settings.label }}"
                loading="lazy"
                width="500"
                height="500"
              >
            {%- endif -%}
          </span>
        {%- else -%}
          <span class="rp-category-card__icon">
            {% render 'rp-icon', icon: block.settings.icon %}
          </span>
        {%- endif -%}
        <span class="rp-category-card__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RP · Categorías",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior",
      "default": "Compra por mascota"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Para cada miembro de tu familia peluda"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Elige la especie y descubre productos pensados solo para ella."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "default": "dog",
          "options": [
            { "value": "dog", "label": "Perro" },
            { "value": "cat", "label": "Gato" },
            { "value": "rabbit", "label": "Conejo" },
            { "value": "bird", "label": "Ave" },
            { "value": "fish", "label": "Pez" },
            { "value": "rodent", "label": "Roedor (hámster, cobaya...)" },
            { "value": "reptile", "label": "Reptil" },
            { "value": "other", "label": "Otras mascotas" },
            { "value": "leash", "label": "Paseo" },
            { "value": "moon", "label": "Descanso" },
            { "value": "toy", "label": "Juguetes" },
            { "value": "bowl", "label": "Comederos" },
            { "value": "frog", "label": "Anfibios" },
            { "value": "aquarium", "label": "Acuarios y decoración" },
            { "value": "terrarium", "label": "Terrarios y hábitats" },
            { "value": "pill", "label": "Salud y suplementos" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional, sustituye al icono)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Nombre de la categoría",
          "default": "Perros"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (colección)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RP · Categorías de mascotas",
      "blocks": [
        { "type": "category", "settings": { "icon": "dog", "label": "Perros" } },
        { "type": "category", "settings": { "icon": "cat", "label": "Gatos" } },
        { "type": "category", "settings": { "icon": "rabbit", "label": "Conejos" } },
        { "type": "category", "settings": { "icon": "bird", "label": "Aves" } },
        { "type": "category", "settings": { "icon": "fish", "label": "Peces" } },
        { "type": "category", "settings": { "icon": "rodent", "label": "Hámsters y roedores" } },
        { "type": "category", "settings": { "icon": "other", "label": "Otras mascotas" } }
      ]
    }
  ]
}
{% endschema %}
