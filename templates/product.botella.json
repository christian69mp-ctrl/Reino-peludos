{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "trust_badges": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "truck",
            "heading_1": "Envío gratis 5-8 días",
            "icon_2": "return",
            "heading_2": "Devolución gratis 30 días",
            "icon_3": "lock",
            "heading_3": "Pago 100% seguro"
          }
        },
        "description": {
          "type": "description"
        },
        "care_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Cuidado del producto",
            "icon": "heart",
            "content": "<p>Lávala con agua y jabón neutro después de cada uso y déjala secar al aire antes de guardarla.</p>"
          }
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Envíos y devoluciones",
            "icon": "truck",
            "content": "<p>Envío gratuito a cualquier parte del mundo, con entrega en 5-8 días laborables. Si no queda feliz, tienes 30 días para devolverlo sin coste.</p>"
          }
        },
        "faq_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Preguntas frecuentes",
            "icon": "chat",
            "content": "<p><strong>¿Se engancha a cualquier correa?</strong><br>Sí, el mosquetón se engancha a la mayoría de correas y también a asas de mochila.</p><p><strong>¿Puedo elegir el pack al comprar?</strong><br>Sí, elige el formato (unidad, pack doble o pack regalo). En los packs también puedes elegir \"Mixto\" para recibir una combinación de ambos colores en vez de uno solo.</p><p><strong>¿Cuánto tarda en llegar?</strong><br>El envío es gratuito a cualquier parte del mundo, con entrega en 5-8 días laborables.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartir"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust_badges",
        "description",
        "care_tab",
        "shipping_tab",
        "faq_tab",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "rp_benefits": {
      "type": "rp-product-benefits",
      "settings": {
        "color_scheme": "scheme-2",
        "eyebrow": "Pensado para el paseo",
        "title": "Hidratación sin complicaciones"
      },
      "blocks": {
        "b1": {
          "type": "benefit",
          "settings": {
            "icon": "bowl",
            "title": "Se convierte en cuenco",
            "text": "Se abre en segundos para que tu perro beba directamente, sin derrames."
          }
        },
        "b2": {
          "type": "benefit",
          "settings": {
            "icon": "leash",
            "title": "Va contigo a todas partes",
            "text": "Se engancha a la correa o a la mochila con su asa y mosquetón."
          }
        },
        "b3": {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Cierre hermético",
            "text": "La tapa cierra bien para que no se derrame agua dentro del bolso."
          }
        },
        "b4": {
          "type": "benefit",
          "settings": {
            "icon": "wave",
            "title": "Ligera y compacta",
            "text": "Cabe en cualquier bolsillo o bolsa, ideal para paseos cortos o largos."
          }
        }
      },
      "block_order": ["b1", "b2", "b3", "b4"]
    },
    "rp_spotlight": {
      "type": "rp-product-spotlight",
      "settings": {
        "media_index": 4,
        "overlay": "dark",
        "eyebrow": "Momento Reino Peludos",
        "heading": "Agua fresca, esté donde esté",
        "subheading": "Para que nunca le falte agua en el paseo, el parque o el coche."
      }
    },
    "rp_reviews": {
      "type": "rp-testimonials",
      "settings": {
        "color_scheme": "scheme-1",
        "use_sample_image": false,
        "eyebrow": "Reino Peludos",
        "title": "Por qué la vas a usar en cada paseo"
      },
      "blocks": {
        "t1": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Se abre en un segundo y se convierte en un cuenco: ideal para dar de beber a tu perro sin necesidad de llevar nada más.",
            "pet_icon": "dog",
            "author": "Equipo Reino Peludos",
            "pet_name": "Botella de paseo para perros"
          }
        },
        "t2": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "El asa con mosquetón la engancha directamente a la correa, así nunca se te olvida en casa.",
            "pet_icon": "dog",
            "author": "Equipo Reino Peludos",
            "pet_name": "Botella de paseo para perros"
          }
        }
      },
      "block_order": ["t1", "t2"]
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Combina también con",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 44,
        "padding_bottom": 44
      }
    }
  },
  "order": [
    "main",
    "rp_benefits",
    "rp_spotlight",
    "rp_reviews",
    "disclosures",
    "related-products"
  ]
}
