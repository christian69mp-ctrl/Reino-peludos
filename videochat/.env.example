# ====================================================================
#  La Ruleta Caliente: configuración del servidor
#  Copia este archivo como .env y rellena los valores.
#  NUNCA subas el archivo .env a GitHub ni se lo enseñes a nadie.
#  Para generar claves aleatorias:  openssl rand -hex 32
# ====================================================================

# ---------- Imprescindible ----------
# tu dominio, sin https:// (el DNS debe apuntar al servidor)
DOMAIN=laruletacaliente.com
# para el certificado HTTPS gratuito (avisos de caducidad)
ACME_EMAIL=tu@email.com
# openssl rand -hex 32
SESSION_SECRET=
# contraseña del panel /admin: larga (16+ caracteres) y que no uses en ningún otro sitio.
# Después, activa la verificación en dos pasos en /admin → Seguridad.
ADMIN_PASSWORD=
# recibe avisos: denuncias urgentes, suspensiones, menores
ADMIN_EMAIL=tu@email.com
# openssl rand -hex 32 (lo comparten la web y el servidor TURN)
TURN_SECRET=

# ---------- Web cerrada con contraseña (antes de abrir al público) ----------
# Con esto, el navegador pide usuario y contraseña antes de mostrar la web (el usuario da igual).
# Bórralo (o déjalo vacío) el día que abras al público y ejecuta  docker compose up -d
# SITE_PASSWORD=

# ---------- Premium / pagos ----------
# Premium es de pago desde el primer día: rellena los SEGPAY_* (requiere alta de autónomo o empresa).
# Sin SEGPAY_* la web funciona en modo DEMO: el pago se SIMULA (solo para probar; no abras así).
# free = todo lo de Premium gratis para todos y no se cobra nada (si algún día lo necesitas).
# PREMIUM_MODE=free
# Prueba de Premium gratis al crear la cuenta: DESACTIVADA. Para activarla, pon los días (una vez por email).
# TRIAL_DAYS=1
# Cuando tengas cuenta en Segpay (requiere ser autónomo o empresa):
# SEGPAY_ETICKET_CARD_WEEK=123456:7888
# SEGPAY_ETICKET_CRYPTO_WEEK=123456:7889
# SEGPAY_ETICKET_CARD=123456:7890
# SEGPAY_ETICKET_CRYPTO=123456:7891
# openssl rand -hex 24
# SEGPAY_POSTBACK_KEY=
# SEGPAY_CANCEL_URL=https://cs.segpay.com

# ---------- Emails (confirmar email, recuperar contraseña, avisos) ----------
# Brevo tiene plan gratuito (300 emails/día). Sin SMTP_HOST los emails no se envían.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="La Ruleta Caliente <no-reply@laruletacaliente.com>"

# ---------- Verificación de edad con documento (Veriff) ----------
# Al registrarse basta con confirmar «Tengo 18 años o más». Solo quien sea denunciado como
# posible menor (o a quien se lo pidas en /admin) tiene que verificarse con documento.
# Sin estas dos claves esa verificación se SIMULA (modo demo): no abras al público así.
VERIFF_API_KEY=
VERIFF_SECRET=
# Para pedir el documento a todo el mundo antes del primer videochat:
# AGE_VERIFICATION=all

# ---------- Google Search Console y Bing (posicionamiento) ----------
# Solo si verificas con «Prefijo de URL» y la etiqueta HTML: pega aquí el valor de content="…".
# Si verificas el dominio con un registro TXT en el DNS (recomendado), déjalo vacío.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------- Entrar con Google, Apple o Facebook ----------
# Cada botón aparece solo si pones sus claves (ver DESPLIEGUE.md, paso 7).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Ruta del archivo .p8 dentro del contenedor (o pega su contenido en APPLE_PRIVATE_KEY)
APPLE_PRIVATE_KEY_FILE=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Protección contra bots (Cloudflare Turnstile, gratis) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---------- Traducción del chat (opcional) ----------
# DeepL gratis: 500.000 caracteres/mes (la clave gratuita termina en :fx)
DEEPL_API_KEY=
# LIBRETRANSLATE_URL=https://tu-libretranslate.com
# LIBRETRANSLATE_API_KEY=

# ---------- Vídeo ----------
# Por privacidad el vídeo pasa por tu servidor TURN y nadie ve la IP de la otra persona.
# Si gasta demasiado tráfico, RELAY_ONLY=off (el vídeo irá directo cuando se pueda).
# RELAY_ONLY=off

# ---------- Filtros «Mi país» y «Cerca de mí» ----------
# La web descarga sola cada mes una base de datos gratuita de ubicación por IP (DB-IP, ~130 MB).
# NEAR_KM=100
# GEOIP_AUTO_UPDATE=off

# ---------- Notificaciones push ----------
# Las claves se generan solas la primera vez y se guardan en la base de datos.
# Solo si quieres fijarlas tú (npx web-push generate-vapid-keys):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@laruletacaliente.com

# ---------- Copias de seguridad ----------
# Se hace una copia de la base de datos al arrancar y cada 24 h (data/copias).
# cuántas copias se guardan
# BACKUP_KEEP=14
