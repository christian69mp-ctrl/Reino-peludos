# ====================================================================
#  La Ruleta Caliente: configuración del servidor
#  Copia este archivo como .env y rellena los valores.
#  NUNCA subas el archivo .env a GitHub ni se lo enseñes a nadie.
#  Para generar claves aleatorias:  openssl rand -hex 32
# ====================================================================

# ---------- Imprescindible ----------
# tu dominio, sin https:// (el DNS debe apuntar al servidor)
DOMAIN=laruletacaliente.com
# para el certificado HTTPS gratuito (avisos de caducidad)
ACME_EMAIL=tu@email.com
# openssl rand -hex 32
SESSION_SECRET=
# contraseña del panel /admin (larga y única)
ADMIN_PASSWORD=
# recibe avisos: denuncias urgentes, suspensiones, menores
ADMIN_EMAIL=tu@email.com
# openssl rand -hex 32 (lo comparten la web y el servidor TURN)
TURN_SECRET=

# ---------- Premium / pagos ----------
# free = lanzamiento: filtros gratis para todos y no se cobra nada (mientras no
#        seas autónomo o empresa). Quita esta línea cuando tengas Segpay.
PREMIUM_MODE=free
# Cuando tengas cuenta en Segpay (requiere ser autónomo o empresa):
# SEGPAY_ETICKET_CARD_WEEK=123456:7888
# SEGPAY_ETICKET_CRYPTO_WEEK=123456:7889
# SEGPAY_ETICKET_CARD=123456:7890
# SEGPAY_ETICKET_CRYPTO=123456:7891
# openssl rand -hex 24
# SEGPAY_POSTBACK_KEY=
# SEGPAY_CANCEL_URL=https://cs.segpay.com

# ---------- Emails (confirmar email, recuperar contraseña, avisos) ----------
# Brevo tiene plan gratuito (300 emails/día). Sin SMTP_HOST los emails no se envían.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="La Ruleta Caliente <no-reply@laruletacaliente.com>"

# ---------- Verificación de edad con documento (Veriff) ----------
# Sin estas dos claves la verificación se SIMULA (modo demo): no abras al público así.
VERIFF_API_KEY=
VERIFF_SECRET=

# ---------- Protección contra bots (Cloudflare Turnstile, gratis) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---------- Traducción del chat (opcional) ----------
# DeepL gratis: 500.000 caracteres/mes (la clave gratuita termina en :fx)
DEEPL_API_KEY=
# LIBRETRANSLATE_URL=https://tu-libretranslate.com
# LIBRETRANSLATE_API_KEY=

# ---------- Copias de seguridad ----------
# Se hace una copia de la base de datos al arrancar y cada 24 h (data/copias).
# cuántas copias se guardan
# BACKUP_KEEP=14
