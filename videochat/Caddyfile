# Caddy: HTTPS automático (certificado gratuito de Let's Encrypt) delante de la web.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# Subdominio solo para el código de la red de anuncios (ADS_ORIGIN en .env)
ads.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
