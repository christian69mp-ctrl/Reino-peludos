{%- comment -%}
  Renders a small inline SVG icon for pet categories and brand accents.
  Usage: {% render 'rp-icon', icon: 'dog' %}
  Accepted values: dog, cat, rabbit, bird, fish, rodent, reptile, paw, crown
{%- endcomment -%}
{%- case icon -%}
  {%- when 'dog' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M20 14c-4 0-7 4-6 9l2 8" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <path d="M44 14c4 0 7 4 6 9l-2 8" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <path d="M18 30c0-9 6-16 14-16s14 7 14 16v6c0 9-6 15-14 15s-14-6-14-15v-6Z" stroke="currentColor" stroke-width="3"/>
      <circle cx="26" cy="30" r="2" fill="currentColor"/>
      <circle cx="38" cy="30" r="2" fill="currentColor"/>
      <path d="M29 38c1.5 1.5 4.5 1.5 6 0" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
    </svg>
  {%- when 'cat' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M20 12 16 26" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M44 12l4 14" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 26c2-4 6-6 16-6s14 2 16 6c2 4 2 10 2 14 0 8-8 13-18 13s-18-5-18-13c0-4 0-10 2-14Z" stroke="currentColor" stroke-width="3"/>
      <circle cx="26" cy="32" r="2" fill="currentColor"/>
      <circle cx="38" cy="32" r="2" fill="currentColor"/>
      <path d="M30 38h4l-2 2-2-2Z" fill="currentColor"/>
      <path d="M20 40c-3 1-5 3-5 3M44 40c3 1 5 3 5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  {%- when 'rabbit' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 26C22 16 24 8 27 8s5 10 3 20" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <path d="M40 26C42 16 40 8 37 8s-5 10-3 20" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <ellipse cx="32" cy="38" rx="16" ry="14" stroke="currentColor" stroke-width="3"/>
      <circle cx="27" cy="36" r="2" fill="currentColor"/>
      <circle cx="37" cy="36" r="2" fill="currentColor"/>
      <path d="M30 42c1.2 1.2 2.8 1.2 4 0" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  {%- when 'bird' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M14 36c0-11 9-20 20-20 9 0 16 6 18 14-3-1-6-1-8 1 4 2 6 6 6 10-4 3-9 4-13 2 1 6-2 11-7 13-1-5-4-8-8-9-4 3-9 3-13 0 3-2 5-5 5-9-4-1-7-4-8-8 3 1 6 1 8-2-2-4 0-8 4-9-2 2-3 4-3 7Z" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round"/>
      <circle cx="40" cy="24" r="1.6" fill="currentColor"/>
    </svg>
  {%- when 'fish' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M10 32c8-10 20-14 30-14 8 0 14 5 14 8s-6 8-14 8c-10 0-22-4-30-14 0 8 2 16 6 22" stroke="currentColor" stroke-width="2.8" stroke-linejoin="round" stroke-linecap="round"/>
      <path d="M44 26l8-8v20l-8-8" stroke="currentColor" stroke-width="2.8" stroke-linejoin="round"/>
      <circle cx="22" cy="30" r="1.8" fill="currentColor"/>
      <path d="M14 40c-2 2-3 5-3 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
  {%- when 'rodent' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="20" cy="20" r="6" stroke="currentColor" stroke-width="2.6"/>
      <circle cx="34" cy="18" r="6" stroke="currentColor" stroke-width="2.6"/>
      <ellipse cx="30" cy="38" rx="17" ry="14" stroke="currentColor" stroke-width="3"/>
      <circle cx="25" cy="36" r="2" fill="currentColor"/>
      <circle cx="35" cy="36" r="2" fill="currentColor"/>
      <path d="M28 41h4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    </svg>
  {%- when 'reptile' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M10 44c6-14 12-24 22-28 6-2 12 0 14 6 2 5-1 10-6 11 5 1 9 5 8 10-2 8-14 10-22 6" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="38" cy="20" r="1.8" fill="currentColor"/>
      <path d="M14 42c-2 2-3 4-3 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
  {%- when 'paw' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <ellipse cx="32" cy="42" rx="14" ry="11" fill="currentColor"/>
      <circle cx="16" cy="28" r="6" fill="currentColor"/>
      <circle cx="30" cy="18" r="6.5" fill="currentColor"/>
      <circle cx="44" cy="28" r="6" fill="currentColor"/>
      <circle cx="48" cy="40" r="5" fill="currentColor"/>
    </svg>
  {%- when 'crown' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M10 46 6 22l14 10 12-18 12 18 14-10-4 24H10Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" fill="none"/>
      <path d="M10 46h44v6H10z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" fill="none"/>
    </svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M6 18h28v22H6z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <path d="M34 26h10l10 8v6H34z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <circle cx="18" cy="46" r="5" stroke="currentColor" stroke-width="3"/>
      <circle cx="46" cy="46" r="5" stroke="currentColor" stroke-width="3"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M32 8l20 7v16c0 13-8 21-20 25-12-4-20-12-20-25V15l20-7Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <path d="M24 32l6 6 12-12" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'return' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M14 24a18 18 0 1 1-3 14" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <path d="M6 16v12h12" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M32 52 12 34c-6-6-6-15 0-20 5-5 13-5 18 0l2 2 2-2c5-5 13-5 18 0 6 5 6 14 0 20L32 52Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
    </svg>
  {%- when 'leash' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M8 12c10 0 8 10 18 10s8-10 18-10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <path d="M44 12c6 0 12 5 12 14s-8 14-14 14c-8 0-10-8-10-14" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      <circle cx="30" cy="48" r="6" stroke="currentColor" stroke-width="3"/>
      <path d="M34 44l6-6" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
    </svg>
  {%- when 'moon' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M40 10a22 22 0 1 0 14 14 17 17 0 0 1-14-14Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <path d="M46 12l2 4 4 2-4 2-2 4-2-4-4-2 4-2 2-4Z" fill="currentColor"/>
    </svg>
  {%- when 'toy' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="32" cy="32" r="18" stroke="currentColor" stroke-width="3"/>
      <path d="M32 14v6M32 44v6M14 32h6M44 32h6M19 19l4 4M41 41l4 4M45 19l-4 4M23 41l-4 4" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
    </svg>
  {%- when 'bowl' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M8 30h48c0 10-8 20-24 20S8 40 8 30Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
      <ellipse cx="32" cy="30" rx="24" ry="6" stroke="currentColor" stroke-width="3"/>
      <path d="M22 16c0-3 2-5 4-5M32 13c0-3 2-5 4-5M42 16c0-3 2-5 4-5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    </svg>
  {%- when 'frog' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="22" cy="20" r="6" stroke="currentColor" stroke-width="2.6"/>
      <circle cx="42" cy="20" r="6" stroke="currentColor" stroke-width="2.6"/>
      <circle cx="22" cy="20" r="1.6" fill="currentColor"/>
      <circle cx="42" cy="20" r="1.6" fill="currentColor"/>
      <path d="M14 30c0-4 4-6 18-6s18 2 18 6c4 2 6 6 6 10 0 10-11 16-24 16S8 50 8 40c0-4 2-8 6-10Z" stroke="currentColor" stroke-width="2.8" stroke-linejoin="round"/>
      <path d="M24 44c2.6 2 7.4 2 10 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
    </svg>
  {%- when 'aquarium' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="8" y="16" width="48" height="34" rx="2" stroke="currentColor" stroke-width="3"/>
      <path d="M8 34h48" stroke="currentColor" stroke-width="2" stroke-opacity="0.5"/>
      <path d="M18 42c4-4 8 4 12 0s8 4 12 0" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M40 24l5-4 5 4-5 4-5-4Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
    </svg>
  {%- when 'terrarium' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="10" y="10" width="44" height="44" rx="2" stroke="currentColor" stroke-width="3"/>
      <path d="M10 40h44" stroke="currentColor" stroke-width="2.4"/>
      <path d="M22 40V26l14-8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M10 18h44" stroke="currentColor" stroke-width="2" stroke-opacity="0.5"/>
    </svg>
  {%- when 'pill' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="10" y="26" width="44" height="18" rx="9" stroke="currentColor" stroke-width="3" transform="rotate(-30 32 32)"/>
      <path d="M27 21l10 22" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" transform="rotate(-30 32 32)"/>
    </svg>
  {%- when 'other' -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M32 8c3 6-1 10-1 10s10-2 13 5-3 11-3 11 9 2 9 10-9 8-9 8" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="32" cy="40" r="16" stroke="currentColor" stroke-width="3"/>
      <path d="M25 40a7 7 0 0 1 14 0" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="32" cy="32" r="18" stroke="currentColor" stroke-width="3"/>
    </svg>
{%- endcase -%}
